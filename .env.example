# Copy to .env.local. All optional — the app runs fully on localStorage without any.

# --- Google Sheets storage (temporary backend) ---
# Apps Script Web App /exec URL — see docs/google-sheets-storage.md.
# When set, the app loads from / saves to the Sheet (localStorage is the cache).
VITE_SHEETS_WEBAPP_URL= https://script.google.com/macros/s/AKfycbzQ5STOoygZzrdyd8gE7aOJ7JGc5oelxJJ832eOk_NnhsL0cInuIIA0EJg0YURPS8kr2A/exec

# --- Supabase (Fase 2+) — values from `supabase status` ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Claude API (DEV ONLY) ---
# If set, the AI Daily Briefing calls Claude directly from the browser.
# The key is exposed to the client — production must run the ai-daily Edge Function instead.
VITE_ANTHROPIC_API_KEY=
